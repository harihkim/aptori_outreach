# PostgreSQL canonical state. Local peer authentication is the development default.
APTORI_DATABASE_URL=postgresql+psycopg://@/aptori_outreach

# Bound database connection establishment, including GET /health probes.
APTORI_DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Deployment bearer token required by every Campaign route.
APTORI_API_TOKEN=replace-with-a-long-random-token

# Retrieval output is temporary; finalized bundles are written to the durable
# EvidenceStore root. Keep these roots separate, including across filesystems.
# APTORI_RETRIEVAL_STAGING_ROOT=/var/tmp/aptori-retrieval-staging
# APTORI_RETRIEVAL_EVIDENCE_ROOT=/var/lib/aptori/evidence

# EvidenceStore safety limits (defaults are bounded in app/config.py).
# APTORI_EVIDENCE_STORE_MAX_ARTIFACTS=128
# APTORI_EVIDENCE_STORE_MAX_ARTIFACT_BYTES=134217728
# APTORI_EVIDENCE_STORE_MAX_TOTAL_BYTES=536870912
# APTORI_EVIDENCE_STORE_MAX_MANIFEST_BYTES=1048576
# APTORI_EVIDENCE_STORE_MAX_NAME_BYTES=255
# APTORI_EVIDENCE_STORE_MAX_ROLE_BYTES=128
# APTORI_EVIDENCE_STORE_MAX_MEDIA_TYPE_BYTES=255
